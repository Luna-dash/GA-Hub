# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.Python
.venv/
venv/
env/
ENV/

# ── Node / webui ──────────────────────────────────────────────
node_modules/
webui/node_modules/
src-tauri/target/
src-tauri/gen/
target/
webui/dist/
webui/.vite/
webui/tsconfig.tsbuildinfo
# vitest 把 config 转译成临时文件；进程被中断（如超时 SIGTERM）时会残留
vitest.config.ts.timestamp-*.mjs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── PyInstaller / installers ──────────────────────────────────
build/build/
build/dist/
build/*.dmg
build/*.exe
build/*.log
dist/

# ── OS / IDE ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Secrets / local data (defensive — these live outside the repo) ─
.env
.env.*
*.key
*.pem
/mykey.py
secrets.json

# ── Misc ──────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Local scratch / debug artifacts ───────────────────────────
temp/
.compare_launch_diff.txt
.ga-staging/
.zcode/
mockups/
# Agent 工作区：CDP 渲染截图 + 本地记忆，纯本机产物（无 skills/ 等需共享内容）
.workbuddy/
# 本机私有项目笔记（此前只靠 .git/info/exclude 兜着，换机 clone 会露出）
project_memory.md

# pytest local temp dirs (any variant, e.g. .pytest_tmp_update_audit/)
.pytest_tmp*/

# 根目录本机散件（2026-09-23 仓库卫生审查增补：git status 长期污染源）
# ⚠ 这节是「当时那批名字」的快照，再加名字治不了根：两天后根目录又长出 32 条
# （2026-09-24/25，见 docs/BACKLOG.md 问题 9）。新散件请放 temp/（已忽略）或归
# docs/archive/，越界由 tests/test_repo_hygiene.py 拦截。此处只留历史日志模式。
.tmp/
/msg_*.json
/pytest-*/
/*-final.log
/phone_bridge*.log
/proxy*.log
/sim_run*.log
/smoke_run*.log
/vite_dev.log
/preflight.log
webui/pnpm-*.yaml
